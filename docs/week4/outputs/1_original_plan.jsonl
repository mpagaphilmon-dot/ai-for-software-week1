{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bvto2Cwmmd9GyAfqHMHMbh","type":"tool_result","content":"data/sample.csv\nexpenses/__init__.py\nexpenses/__main__.py\nexpenses/cli.py\nexpenses/models.py\nexpenses/report.py\nexpenses/storage.py\ntests/__init__.py\ntests/test_cli.py\ntests/test_report.py\ntests/test_storage.py\ndate,category,amount,note\n2026-09-02,food,12.50,lunch\n2026-09-03,transport,3.20,bus\n2026-09-10,food,48.90,groceries\n2026-09-15,rent,650.00,\n2026-10-01,transport,3.20,bus\n2026-10-04,food,9.75,lunch\n\"\"\"A tiny command-line expense tracker backed by a CSV file.\"\"\"\nfrom expenses.cli import main\n\nraise SystemExit(main())\nimport argparse\nfrom datetime import date\n\nfrom expenses.models import Expense\nfrom expenses.report import total, total_by_category\nfrom expenses.storage import append_expense, load_expenses\n\nDEFAULT_FILE = \"data/expenses.csv\"\n\n\ndef build_parser():\n    parser = argparse.ArgumentParser(prog=\"expenses\", description=\"Track expenses in a CSV file.\")\n    parser.add_argument(\"--file\", default=DEFAULT_FILE, help=\"CSV file to read and write\")\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n\n    add = commands.add_parser(\"add\", help=\"record a new expense\")\n    add.add_argument(\"category\")\n    add.add_argument(\"amount\", type=float)\n    add.add_argument(\"--note\", default=\"\")\n    add.add_argument(\"--date\", type=date.fromisoformat, default=None, help=\"YYYY-MM-DD, defaults to today\")\n\n    commands.add_parser(\"list\", help=\"show every expense\")\n    commands.add_parser(\"summary\", help=\"show totals per category\")\n    return parser\n\n\ndef main(argv=None):\n    args = build_parser().parse_args(argv)\n\n    if args.command == \"add\":\n        expense = Expense(\n            day=args.date or date.today(),\n            category=args.category.strip().lower(),\n            amount=args.amount,\n            note=args.note,\n        )\n        append_expense(args.file, expense)\n        print(f\"Added {expense.amount:.2f} to {expense.category}\")\n        return 0\n\n    expenses = load_expenses(args.file)\n\n    if args.command == \"list\":\n        for e in expenses:\n            print(f\"{e.day}  {e.category:<12} {e.amount:>9.2f}  {e.note}\")\n        return 0\n\n    for category, amount in total_by_category(expenses).items():\n        print(f\"{category:<12} {amount:>9.2f}\")\n    print(f\"{'total':<12} {total(expenses):>9.2f}\")\n    return 0\nfrom dataclasses import dataclass\nfrom datetime import date\n\n\n@dataclass(frozen=True)\nclass Expense:\n    day: date\n    category: str\n    amount: float\n    note: str = \"\"\nfrom collections import defaultdict\n\n\ndef total(expenses):\n    \"\"\"Sum of all expense amounts, rounded to cents.\"\"\"\n    return round(sum(e.amount for e in expenses), 2)\n\n\ndef total_by_category(expenses):\n    \"\"\"Map each category to its total, sorted from largest to smallest.\"\"\"\n    totals = defaultdict(float)\n    for e in expenses:\n        totals[e.category] += e.amount\n    ranked = sorted(totals.items(), key=lambda item: item[1], reverse=True)\n    return {category: round(amount, 2) for category, amount in ranked}\n\n\ndef average_by_category(expenses):\n    \"\"\"Map each category to its average expense, sorted from largest to smallest.\"\"\"\n    totals = defaultdict(float)\n    counts = defaultdict(int)\n    for e in expenses:\n        totals[e.category] += e.amount\n        counts[e.category] += 1\n    averages = {category: totals[category] / counts[category] for category in totals}\n    ranked = sorted(averages.items(), key=lambda item: item[1], reverse=True)\n    return {category: round(amount, 2) for category, amount in ranked}\n\n\ndef monthly_total(expenses, year, month):\n    \"\"\"Sum of the expenses dated in the given year and month, rounded to cents.\"\"\"\n    return round(sum(e.amount for e in expenses if e.day.year == year and e.day.month == month), 2)\n\n\n# expenses_between(expenses, start, end) -> list of Expense\n# Data shape: `expenses` is a list of Expense records (expenses/models.py) whose\n#   `day` is a datetime.date; `start` and `end` are datetime.date objects, not strings.\n# Behavior: keep every expense with start <= e.day <= end. Both bounds are\n#   INCLUSIVE, so an expense dated exactly on `start` or `end` is kept. Return a\n#   new list in the same order as the input (do not sort); never modify the input.\n#   An empty input list returns [].\n# Failure mode: if start > end, raise ValueError(\"start must not be after end\")\n#   instead of silently returning [], which would hide a swapped-argument bug.\ndef expenses_between(expenses, start, end):\n    \"\"\"Expenses dated from start to end inclusive, in their original order.\"\"\"\n    if start > end:\n        raise ValueError(\"start must not be after end\")\n    return [e for e in expenses if start <= e.day <= end]\nimport csv\nfrom datetime import date\nfrom pathlib import Path\n\nfrom expenses.models import Expense\n\nFIELDS = [\"date\", \"category\", \"amount\", \"note\"]\n\n\ndef load_expenses(path):\n    \"\"\"Read every expense from the CSV file at `path`.\n\n    A missing file is treated as an empty ledger.\n    \"\"\"\n    path = Path(path)\n    if not path.exists():\n        return []\n\n    expenses = []\n    with path.open(newline=\"\", encoding=\"utf-8\") as f:\n        for row in csv.DictReader(f):\n            expenses.append(\n                Expense(\n                    day=date.fromisoformat(row[\"date\"]),\n                    category=row[\"category\"].strip().lower(),\n                    amount=float(row[\"amount\"]),\n                    note=row.get(\"note\") or \"\",\n                )\n            )\n    return expenses\n\n\ndef append_expense(path, expense):\n    \"\"\"Add one expense to the CSV file, creating it with a header if needed.\"\"\"\n    path = Path(path)\n    # An existing but empty file has no header yet, so treat it as new.\n    is_new = not path.exists() or path.stat().st_size == 0\n    path.parent.mkdir(parents=True, exist_ok=True)\n\n    # A hand-edited file may lack a trailing newline; without one the new\n    # row would be glued onto the end of the last line.\n    needs_newline = False\n    if not is_new and path.stat().st_size > 0:\n        with path.open(\"rb\") as f:\n            f.seek(-1, 2)\n            needs_newline = f.read(1) not in (b\"\\n\", b\"\\r\")\n\n    with path.open(\"a\", newline=\"\", encoding=\"utf-8\") as f:\n        writer = csv.DictWriter(f, fieldnames=FIELDS)\n        if needs_newline:\n            f.write(\"\\r\\n\")\n        if is_new:\n            writer.writeheader()\n        writer.writerow(\n            {\n                \"date\": expense.day.isoformat(),\n                \"category\": expense.category,\n                \"amount\": f\"{expense.amount:.2f}\",\n                \"note\": expense.note,\n            }\n        )\nimport io\nimport tempfile\nimport unittest\nfrom contextlib import redirect_stderr, redirect_stdout\nfrom pathlib import Path\n\nfrom expenses.cli import main\nfrom expenses.storage import load_expenses\n\n\ndef run(argv):\n    out = io.StringIO()\n    with redirect_stdout(out):\n        code = main(argv)\n    return code, out.getvalue()\n\n\nclass CliTests(unittest.TestCase):\n    def test_add_then_summary(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            path = str(Path(tmp) / \"expenses.csv\")\n\n            code, out = run([\"--file\", path, \"add\", \"Food\", \"12.5\", \"--note\", \"lunch\"])\n            self.assertEqual(code, 0)\n            self.assertIn(\"Added 12.50 to food\", out)\n\n            code, out = run([\"--file\", path, \"summary\"])\n            self.assertEqual(code, 0)\n            lines = out.splitlines()\n            food = [line for line in lines if line.startswith(\"food\")]\n            totals = [line for line in lines if line.startswith(\"total\")]\n            self.assertEqual(len(food), 1)\n            self.assertIn(\"12.50\", food[0])\n            self.assertEqual(len(totals), 1)\n            self.assertIn(\"12.50\", totals[0])\n\n    def test_add_normalises_category(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"expenses.csv\"\n            code, _ = run([\"--file\", str(path), \"add\", \" Food \", \"3\"])\n            self.assertEqual(code, 0)\n            [expense] = load_expenses(path)\n            self.assertEqual(expense.category, \"food\")\n\n    def test_add_rejects_non_numeric_amount(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"expenses.csv\"\n            with redirect_stderr(io.StringIO()), redirect_stdout(io.StringIO()):\n                with self.assertRaises(SystemExit) as ctx:\n                    main([\"--file\", str(path), \"add\", \"Food\", \"abc\"])\n            self.assertEqual(ctx.exception.code, 2)\n            self.assertFalse(path.exists())\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nimport unittest\r\nfrom datetime import date\r\n\r\nfrom expenses.models import Expense\r\nfrom expenses.report import (\r\n    average_by_category,\r\n    expenses_between,\r\n    monthly_total,\r\n    total,\r\n    total_by_category,\r\n)\r\n\r\nEXPENSES = [\r\n    Expense(date(2026, 9, 2), \"food\", 12.50),\r\n    Expense(date(2026, 9, 3), \"transport\", 3.20),\r\n    Expense(date(2026, 10, 4), \"food\", 9.75),\r\n]\r\n\r\nSAMPLE = [\r\n    Expense(date(2026, 9, 2), \"food\", 12.50, \"lunch\"),\r\n    Expense(date(2026, 9, 3), \"transport\", 3.20, \"bus\"),\r\n    Expense(date(2026, 9, 10), \"food\", 48.90, \"groceries\"),\r\n    Expense(date(2026, 9, 15), \"rent\", 650.00, \"\"),\r\n    Expense(date(2026, 10, 1), \"transport\", 3.20, \"bus\"),\r\n    Expense(date(2026, 10, 4), \"food\", 9.75, \"lunch\"),\r\n]\r\n\r\n\r\nclass ReportTests(unittest.TestCase):\r\n    def test_total(self):\r\n        self.assertEqual(total(EXPENSES), 25.45)\r\n\r\n    def test_total_of_nothing_is_zero(self):\r\n        self.assertEqual(total([]), 0)\r\n\r\n    def test_total_by_category_is_sorted_largest_first(self):\r\n        self.assertEqual(list(total_by_category(EXPENSES).items()), [(\"food\", 22.25), (\"transport\", 3.20)])\r\n\r\n    def test_monthly_total_only_counts_that_month(self):\r\n        self.assertEqual(monthly_total(EXPENSES, 2026, 9), 15.70)\r\n        self.assertEqual(monthly_total(EXPENSES, 2026, 10), 9.75)\r\n\r\n    def test_monthly_total_does_not_mix_years(self):\r\n        self.assertEqual(monthly_total(EXPENSES, 2025, 9), 0)\r\n\r\n    def test_average_by_category_is_rounded_and_sorted_largest_first(self):\r\n        self.assertEqual(\r\n            list(average_by_category(SAMPLE).items()),\r\n            [(\"rent\", 650.0), (\"food\", 23.72), (\"transport\", 3.2)],\r\n        )\r\n\r\n    def test_average_by_category_of_nothing_is_empty(self):\r\n        self.assertEqual(average_by_category([]), {})\r\n\r\n    def test_expenses_between_includes_both_bounds(self):\r\n        self.assertEqual(\r\n            expenses_between(SAMPLE, date(2026, 9, 3), date(2026, 9, 15)),\r\n            SAMPLE[1:4],\r\n        )\r\n\r\n    def test_expenses_between_keeps_input_order(self):\r\n        shuffled = [SAMPLE[5], SAMPLE[0], SAMPLE[4]]\r\n        self.assertEqual(\r\n            expenses_between(shuffled, date(2026, 9, 1), date(2026, 10, 31)),\r\n            shuffled,\r\n        )\r\n\r\n    def test_expenses_between_does_not_modify_input(self):\r\n        expenses = list(SAMPLE)\r\n        expenses_between(expenses, date(2026, 10, 1), date(2026, 10, 1))\r\n        self.assertEqual(expenses, SAMPLE)\r\n\r\n    def test_expenses_between_of_nothing_is_empty(self):\r\n        self.assertEqual(expenses_between([], date(2026, 9, 1), date(2026, 9, 30)), [])\r\n\r\n    def test_expenses_between_rejects_start_after_end(self):\r\n        with self.assertRaisesRegex(ValueError, \"start must not be after end\"):\r\n            expenses_between(SAMPLE, date(2026, 10, 1), date(2026, 9, 1))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\nimport tempfile\nimport unittest\nfrom datetime import date\nfrom pathlib import Path\n\nfrom expenses.models import Expense\nfrom expenses.storage import append_expense, load_expenses\n\n\nclass StorageTests(unittest.TestCase):\n    def test_missing_file_is_empty(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            self.assertEqual(load_expenses(Path(tmp) / \"none.csv\"), [])\n\n    def test_round_trip(self):\n        expense = Expense(date(2026, 9, 2), \"food\", 12.5, \"lunch\")\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"nested\" / \"expenses.csv\"\n            append_expense(path, expense)\n            append_expense(path, expense)\n            self.assertEqual(load_expenses(path), [expense, expense])\n\n    def test_append_to_empty_file_writes_header(self):\n        expense = Expense(date(2026, 9, 2), \"food\", 12.5, \"lunch\")\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"empty.csv\"\n            path.write_bytes(b\"\")\n            append_expense(path, expense)\n            self.assertEqual(load_expenses(path), [expense])\n\n    def test_append_to_file_without_trailing_newline(self):\n        existing = Expense(date(2026, 9, 2), \"food\", 12.5, \"lunch\")\n        added = Expense(date(2026, 9, 3), \"food\", 5.0, \"snack\")\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"handedit.csv\"\n            path.write_bytes(b\"date,category,amount,note\\n2026-09-02,food,12.50,lunch\")\n            append_expense(path, added)\n            self.assertEqual(load_expenses(path), [existing, added])\n\n    def test_append_to_normal_file_is_unchanged(self):\n        added = Expense(date(2026, 9, 3), \"food\", 5.0, \"snack\")\n        original = b\"date,category,amount,note\\r\\n2026-09-02,food,12.50,lunch\\r\\n\"\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"expenses.csv\"\n            path.write_bytes(original)\n            append_expense(path, added)\n            self.assertEqual(\n                path.read_bytes(), original + b\"2026-09-03,food,5.00,snack\\r\\n\"\n            )\n\n\nif __name__ == \"__main__\":\n    unittest.main()","is_error":false}]},"parent_tool_use_id":null,"session_id":"0706d2f1-2fc1-468b-a628-de205b07fd9c","uuid":"dead8941-712e-415f-9f0c-98c95bc44e3b","timestamp":"2026-11-09T11:44:15.649Z","tool_use_result":{"stdout":"data/sample.csv\nexpenses/__init__.py\nexpenses/__main__.py\nexpenses/cli.py\nexpenses/models.py\nexpenses/report.py\nexpenses/storage.py\ntests/__init__.py\ntests/test_cli.py\ntests/test_report.py\ntests/test_storage.py\ndate,category,amount,note\n2026-09-02,food,12.50,lunch\n2026-09-03,transport,3.20,bus\n2026-09-10,food,48.90,groceries\n2026-09-15,rent,650.00,\n2026-10-01,transport,3.20,bus\n2026-10-04,food,9.75,lunch\n\"\"\"A tiny command-line expense tracker backed by a CSV file.\"\"\"\nfrom expenses.cli import main\n\nraise SystemExit(main())\nimport argparse\nfrom datetime import date\n\nfrom expenses.models import Expense\nfrom expenses.report import total, total_by_category\nfrom expenses.storage import append_expense, load_expenses\n\nDEFAULT_FILE = \"data/expenses.csv\"\n\n\ndef build_parser():\n    parser = argparse.ArgumentParser(prog=\"expenses\", description=\"Track expenses in a CSV file.\")\n    parser.add_argument(\"--file\", default=DEFAULT_FILE, help=\"CSV file to read and write\")\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n\n    add = commands.add_parser(\"add\", help=\"record a new expense\")\n    add.add_argument(\"category\")\n    add.add_argument(\"amount\", type=float)\n    add.add_argument(\"--note\", default=\"\")\n    add.add_argument(\"--date\", type=date.fromisoformat, default=None, help=\"YYYY-MM-DD, defaults to today\")\n\n    commands.add_parser(\"list\", help=\"show every expense\")\n    commands.add_parser(\"summary\", help=\"show totals per category\")\n    return parser\n\n\ndef main(argv=None):\n    args = build_parser().parse_args(argv)\n\n    if args.command == \"add\":\n        expense = Expense(\n            day=args.date or date.today(),\n            category=args.category.strip().lower(),\n            amount=args.amount,\n            note=args.note,\n        )\n        append_expense(args.file, expense)\n        print(f\"Added {expense.amount:.2f} to {expense.category}\")\n        return 0\n\n    expenses = load_expenses(args.file)\n\n    if args.command == \"list\":\n        for e in expenses:\n            print(f\"{e.day}  {e.category:<12} {e.amount:>9.2f}  {e.note}\")\n        return 0\n\n    for category, amount in total_by_category(expenses).items():\n        print(f\"{category:<12} {amount:>9.2f}\")\n    print(f\"{'total':<12} {total(expenses):>9.2f}\")\n    return 0\nfrom dataclasses import dataclass\nfrom datetime import date\n\n\n@dataclass(frozen=True)\nclass Expense:\n    day: date\n    category: str\n    amount: float\n    note: str = \"\"\nfrom collections import defaultdict\n\n\ndef total(expenses):\n    \"\"\"Sum of all expense amounts, rounded to cents.\"\"\"\n    return round(sum(e.amount for e in expenses), 2)\n\n\ndef total_by_category(expenses):\n    \"\"\"Map each category to its total, sorted from largest to smallest.\"\"\"\n    totals = defaultdict(float)\n    for e in expenses:\n        totals[e.category] += e.amount\n    ranked = sorted(totals.items(), key=lambda item: item[1], reverse=True)\n    return {category: round(amount, 2) for category, amount in ranked}\n\n\ndef average_by_category(expenses):\n    \"\"\"Map each category to its average expense, sorted from largest to smallest.\"\"\"\n    totals = defaultdict(float)\n    counts = defaultdict(int)\n    for e in expenses:\n        totals[e.category] += e.amount\n        counts[e.category] += 1\n    averages = {category: totals[category] / counts[category] for category in totals}\n    ranked = sorted(averages.items(), key=lambda item: item[1], reverse=True)\n    return {category: round(amount, 2) for category, amount in ranked}\n\n\ndef monthly_total(expenses, year, month):\n    \"\"\"Sum of the expenses dated in the given year and month, rounded to cents.\"\"\"\n    return round(sum(e.amount for e in expenses if e.day.year == year and e.day.month == month), 2)\n\n\n# expenses_between(expenses, start, end) -> list of Expense\n# Data shape: `expenses` is a list of Expense records (expenses/models.py) whose\n#   `day` is a datetime.date; `start` and `end` are datetime.date objects, not strings.\n# Behavior: keep every expense with start <= e.day <= end. Both bounds are\n#   INCLUSIVE, so an expense dated exactly on `start` or `end` is kept. Return a\n#   new list in the same order as the input (do not sort); never modify the input.\n#   An empty input list returns [].\n# Failure mode: if start > end, raise ValueError(\"start must not be after end\")\n#   instead of silently returning [], which would hide a swapped-argument bug.\ndef expenses_between(expenses, start, end):\n    \"\"\"Expenses dated from start to end inclusive, in their original order.\"\"\"\n    if start > end:\n        raise ValueError(\"start must not be after end\")\n    return [e for e in expenses if start <= e.day <= end]\nimport csv\nfrom datetime import date\nfrom pathlib import Path\n\nfrom expenses.models import Expense\n\nFIELDS = [\"date\", \"category\", \"amount\", \"note\"]\n\n\ndef load_expenses(path):\n    \"\"\"Read every expense from the CSV file at `path`.\n\n    A missing file is treated as an empty ledger.\n    \"\"\"\n    path = Path(path)\n    if not path.exists():\n        return []\n\n    expenses = []\n    with path.open(newline=\"\", encoding=\"utf-8\") as f:\n        for row in csv.DictReader(f):\n            expenses.append(\n                Expense(\n                    day=date.fromisoformat(row[\"date\"]),\n                    category=row[\"category\"].strip().lower(),\n                    amount=float(row[\"amount\"]),\n                    note=row.get(\"note\") or \"\",\n                )\n            )\n    return expenses\n\n\ndef append_expense(path, expense):\n    \"\"\"Add one expense to the CSV file, creating it with a header if needed.\"\"\"\n    path = Path(path)\n    # An existing but empty file has no header yet, so treat it as new.\n    is_new = not path.exists() or path.stat().st_size == 0\n    path.parent.mkdir(parents=True, exist_ok=True)\n\n    # A hand-edited file may lack a trailing newline; without one the new\n    # row would be glued onto the end of the last line.\n    needs_newline = False\n    if not is_new and path.stat().st_size > 0:\n        with path.open(\"rb\") as f:\n            f.seek(-1, 2)\n            needs_newline = f.read(1) not in (b\"\\n\", b\"\\r\")\n\n    with path.open(\"a\", newline=\"\", encoding=\"utf-8\") as f:\n        writer = csv.DictWriter(f, fieldnames=FIELDS)\n        if needs_newline:\n            f.write(\"\\r\\n\")\n        if is_new:\n            writer.writeheader()\n        writer.writerow(\n            {\n                \"date\": expense.day.isoformat(),\n                \"category\": expense.category,\n                \"amount\": f\"{expense.amount:.2f}\",\n                \"note\": expense.note,\n            }\n        )\nimport io\nimport tempfile\nimport unittest\nfrom contextlib import redirect_stderr, redirect_stdout\nfrom pathlib import Path\n\nfrom expenses.cli import main\nfrom expenses.storage import load_expenses\n\n\ndef run(argv):\n    out = io.StringIO()\n    with redirect_stdout(out):\n        code = main(argv)\n    return code, out.getvalue()\n\n\nclass CliTests(unittest.TestCase):\n    def test_add_then_summary(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            path = str(Path(tmp) / \"expenses.csv\")\n\n            code, out = run([\"--file\", path, \"add\", \"Food\", \"12.5\", \"--note\", \"lunch\"])\n            self.assertEqual(code, 0)\n            self.assertIn(\"Added 12.50 to food\", out)\n\n            code, out = run([\"--file\", path, \"summary\"])\n            self.assertEqual(code, 0)\n            lines = out.splitlines()\n            food = [line for line in lines if line.startswith(\"food\")]\n            totals = [line for line in lines if line.startswith(\"total\")]\n            self.assertEqual(len(food), 1)\n            self.assertIn(\"12.50\", food[0])\n            self.assertEqual(len(totals), 1)\n            self.assertIn(\"12.50\", totals[0])\n\n    def test_add_normalises_category(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"expenses.csv\"\n            code, _ = run([\"--file\", str(path), \"add\", \" Food \", \"3\"])\n            self.assertEqual(code, 0)\n            [expense] = load_expenses(path)\n            self.assertEqual(expense.category, \"food\")\n\n    def test_add_rejects_non_numeric_amount(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"expenses.csv\"\n            with redirect_stderr(io.StringIO()), redirect_stdout(io.StringIO()):\n                with self.assertRaises(SystemExit) as ctx:\n                    main([\"--file\", str(path), \"add\", \"Food\", \"abc\"])\n            self.assertEqual(ctx.exception.code, 2)\n            self.assertFalse(path.exists())\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nimport unittest\r\nfrom datetime import date\r\n\r\nfrom expenses.models import Expense\r\nfrom expenses.report import (\r\n    average_by_category,\r\n    expenses_between,\r\n    monthly_total,\r\n    total,\r\n    total_by_category,\r\n)\r\n\r\nEXPENSES = [\r\n    Expense(date(2026, 9, 2), \"food\", 12.50),\r\n    Expense(date(2026, 9, 3), \"transport\", 3.20),\r\n    Expense(date(2026, 10, 4), \"food\", 9.75),\r\n]\r\n\r\nSAMPLE = [\r\n    Expense(date(2026, 9, 2), \"food\", 12.50, \"lunch\"),\r\n    Expense(date(2026, 9, 3), \"transport\", 3.20, \"bus\"),\r\n    Expense(date(2026, 9, 10), \"food\", 48.90, \"groceries\"),\r\n    Expense(date(2026, 9, 15), \"rent\", 650.00, \"\"),\r\n    Expense(date(2026, 10, 1), \"transport\", 3.20, \"bus\"),\r\n    Expense(date(2026, 10, 4), \"food\", 9.75, \"lunch\"),\r\n]\r\n\r\n\r\nclass ReportTests(unittest.TestCase):\r\n    def test_total(self):\r\n        self.assertEqual(total(EXPENSES), 25.45)\r\n\r\n    def test_total_of_nothing_is_zero(self):\r\n        self.assertEqual(total([]), 0)\r\n\r\n    def test_total_by_category_is_sorted_largest_first(self):\r\n        self.assertEqual(list(total_by_category(EXPENSES).items()), [(\"food\", 22.25), (\"transport\", 3.20)])\r\n\r\n    def test_monthly_total_only_counts_that_month(self):\r\n        self.assertEqual(monthly_total(EXPENSES, 2026, 9), 15.70)\r\n        self.assertEqual(monthly_total(EXPENSES, 2026, 10), 9.75)\r\n\r\n    def test_monthly_total_does_not_mix_years(self):\r\n        self.assertEqual(monthly_total(EXPENSES, 2025, 9), 0)\r\n\r\n    def test_average_by_category_is_rounded_and_sorted_largest_first(self):\r\n        self.assertEqual(\r\n            list(average_by_category(SAMPLE).items()),\r\n            [(\"rent\", 650.0), (\"food\", 23.72), (\"transport\", 3.2)],\r\n        )\r\n\r\n    def test_average_by_category_of_nothing_is_empty(self):\r\n        self.assertEqual(average_by_category([]), {})\r\n\r\n    def test_expenses_between_includes_both_bounds(self):\r\n        self.assertEqual(\r\n            expenses_between(SAMPLE, date(2026, 9, 3), date(2026, 9, 15)),\r\n            SAMPLE[1:4],\r\n        )\r\n\r\n    def test_expenses_between_keeps_input_order(self):\r\n        shuffled = [SAMPLE[5], SAMPLE[0], SAMPLE[4]]\r\n        self.assertEqual(\r\n            expenses_between(shuffled, date(2026, 9, 1), date(2026, 10, 31)),\r\n            shuffled,\r\n        )\r\n\r\n    def test_expenses_between_does_not_modify_input(self):\r\n        expenses = list(SAMPLE)\r\n        expenses_between(expenses, date(2026, 10, 1), date(2026, 10, 1))\r\n        self.assertEqual(expenses, SAMPLE)\r\n\r\n    def test_expenses_between_of_nothing_is_empty(self):\r\n        self.assertEqual(expenses_between([], date(2026, 9, 1), date(2026, 9, 30)), [])\r\n\r\n    def test_expenses_between_rejects_start_after_end(self):\r\n        with self.assertRaisesRegex(ValueError, \"start must not be after end\"):\r\n            expenses_between(SAMPLE, date(2026, 10, 1), date(2026, 9, 1))\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main()\r\nimport tempfile\nimport unittest\nfrom datetime import date\nfrom pathlib import Path\n\nfrom expenses.models import Expense\nfrom expenses.storage import append_expense, load_expenses\n\n\nclass StorageTests(unittest.TestCase):\n    def test_missing_file_is_empty(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            self.assertEqual(load_expenses(Path(tmp) / \"none.csv\"), [])\n\n    def test_round_trip(self):\n        expense = Expense(date(2026, 9, 2), \"food\", 12.5, \"lunch\")\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"nested\" / \"expenses.csv\"\n            append_expense(path, expense)\n            append_expense(path, expense)\n            self.assertEqual(load_expenses(path), [expense, expense])\n\n    def test_append_to_empty_file_writes_header(self):\n        expense = Expense(date(2026, 9, 2), \"food\", 12.5, \"lunch\")\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / \"empty.csv\"\n            path.write_bytes(b\"\")\n            append_expense(path, expense)\n            self.assertEqual(load_expenses(path), [expense])\n\n    def test_append_to_file_without_trailing_newline(self):\n        existing = Expense(date(2026, 9, 2), \"food\", 12.5, \"lunch\")\n        added =